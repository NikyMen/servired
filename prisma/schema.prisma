// SERVIRED — esquema de base de datos
// Marketplace de servicios: clientes <-> profesionales verificados

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Cuenta de usuario. `role` define con qué cara entra a la app:
/// cliente (azul, contrata) o profesional (verde, ofrece).
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String // scrypt: "salt:hash" (ver src/lib/auth.ts)
  name         String
  role         String  @default("cliente") // cliente | profesional
  avatarColor  String  @default("#2563eb")
  avatarUrl    String? // foto de perfil subida a /uploads; si falta, van las iniciales

  /// Perfil público. Solo lo tienen las cuentas con role = profesional.
  professional Professional?

  sessions      Session[]
  conversations Conversation[]
  bookings      Booking[]
  requests      ServiceRequest[]
  payments      Payment[]
  reviews       Review[]

  createdAt DateTime @default(now())
}

/// Sesión activa. El token vive en una cookie httpOnly; al salir se borra la fila.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/// Contactos que quieren recibir novedades antes del lanzamiento.
model Preregistration {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  phone      String
  occupation String?
  type       String   @default("cliente")
  createdAt  DateTime @default(now())
}

/// Categorías de servicio (Plomería, Electricidad, Limpieza, etc.)
model Category {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  icon          String // nombre de ícono / emoji para la UI
  professionals Professional[]
  requests      ServiceRequest[]
  parentId      String?
  parent        Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]       @relation("CategoryTree")
  analytics     SearchMetric[]

  createdAt DateTime @default(now())
}

/// Placas publicitarias administrables de la portada.
model Ad {
  id        String   @id @default(cuid())
  slot      String   @unique
  title     String
  imageUrl  String?
  linkUrl   String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Una visita anónima. El navegador actualiza su duración mientras está activo.
model AnalyticsSession {
  id              String   @id @default(cuid())
  sessionKey      String   @unique
  visitorKey      String
  source          String
  country         String?
  city            String?
  firstPath       String
  durationSeconds Int      @default(0)
  startedAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  searches SearchMetric[]
}

/// Búsquedas y usos de categorías para rankings del panel.
model SearchMetric {
  id        String   @id @default(cuid())
  term      String?
  createdAt DateTime @default(now())

  sessionId String
  session   AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

/// Solicitud de presupuesto publicada por un cliente
model ServiceRequest {
  id          String   @id @default(cuid())
  title       String
  description String
  zone        String
  budget      Int? // presupuesto estimado opcional (ARS)
  latitude    Float    @default(-27.4692)
  longitude   Float    @default(-58.8306)
  contactName String // nombre mostrado; la identidad real es userId
  status      String   @default("abierta") // abierta | cerrada
  createdAt   DateTime @default(now())

  /// Quién la publicó. Sin esto, un profesional no tendría a quién contestarle.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
}

/// Profesional / prestador de servicios
model Professional {
  id              String  @id @default(cuid())
  name            String
  headline        String // "Plomero", "Electricista", ...
  bio             String?
  avatarColor     String  @default("#059669") // color para el avatar generado
  avatarUrl       String? // foto de perfil; si falta, se dibujan las iniciales
  coverUrl        String? // foto de portada del perfil público
  rating          Float   @default(0)
  reviewsCount    Int     @default(0)
  zone            String // "Zona Norte, CABA"
  businessName    String?
  address         String?
  latitude        Float?
  longitude       Float?
  priceFrom       Int // precio publicado en ARS
  verified        Boolean @default(false)
  featured        Boolean @default(false)
  yearsExperience Int     @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  /// Cuenta dueña del perfil. Opcional: el seed puede crear perfiles sin cuenta.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  services      Service[]
  reviews       Review[]
  bookings      Booking[]
  conversations Conversation[]
  workPhotos    WorkPhoto[]
  payments      Payment[]

  createdAt DateTime @default(now())
}

/// Foto de un trabajo particular, cargada por el propio profesional.
///
/// No nace de una contratación de ServiRed: no hay cliente del otro lado ni,
/// por lo tanto, calificación posible. Es la muestra de lo que sabe hacer
/// alguien que recién llega y todavía no cerró trabajos por la plataforma.
model WorkPhoto {
  id          String  @id @default(cuid())
  url         String
  title       String
  description String?
  address     String?
  latitude    Float?
  longitude   Float?

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/// Contratación: un cliente contrata a un profesional
model Booking {
  id          String  @id @default(cuid())
  clientName  String // nombre mostrado; la identidad real es userId
  note        String?
  finalPrice  Int? // monto acordado al cerrar el trabajo (ARS)
  quotedPrice Int? // presupuesto que propone el profesional (ARS)
  workSummary String? // breve resumen del trabajo realizado
  status      String  @default("solicitada") // solicitada | presupuestada | aceptada | completada | cancelada

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  attachments ProposalAttachment[]
  payments    Payment[]
  reviews     Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Imagen adjunta a una propuesta enviada desde el perfil público.
model ProposalAttachment {
  id        String   @id @default(cuid())
  url       String
  name      String
  type      String
  size      Int?
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Conversación entre un cliente y un profesional
model Conversation {
  id         String @id @default(cuid())
  clientName String // nombre mostrado; la identidad real es userId

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  messages Message[]
  payments Payment[]

  /// Hasta cuándo miró el hilo cada lado. Null = todavía no lo abrió nunca, así
  /// que todo lo que le escribieron cuenta como sin leer.
  leidoCliente DateTime?
  leidoPro     DateTime?

  /// Novedades del acuerdo (pedido, presupuesto y pago) vistas por cada lado.
  acuerdoLeidoCliente DateTime?
  acuerdoLeidoPro     DateTime?
  pagoLeidoCliente    DateTime?
  pagoLeidoPro        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un solo hilo por par cliente-profesional (dos clientes homónimos ya no chocan).
  @@unique([professionalId, userId])
}

/// Mensaje dentro de una conversación
model Message {
  id     String @id @default(cuid())
  sender String // cliente | profesional
  text   String @default("") // puede ir vacío si el mensaje es solo un adjunto

  /// Adjunto opcional (imagen o PDF) servido desde /uploads.
  attachmentUrl  String?
  attachmentName String?
  attachmentType String? // image/jpeg | image/png | image/webp | application/pdf
  attachmentSize Int? // bytes

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/// Servicio publicado por un profesional
model Service {
  id            String @id @default(cuid())
  title         String
  description   String
  categoryLabel String // etiqueta libre: "Electricidad", "Redes", ...
  priceFrom     Int
  status        String @default("activo") // activo | pausado
  requestsCount Int    @default(0)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  bookings Booking[]

  createdAt DateTime @default(now())
}

/// Reseña verificada dejada por un cliente
model Review {
  id         String   @id @default(cuid())
  authorName String
  rating     Int
  comment    String
  serviceTag String? // servicio al que refiere la opinión
  imageUrl   String?
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

/// Pago de demostracion iniciado desde una conversacion.
model Payment {
  id            String    @id @default(cuid())
  amount        Int
  commission    Int
  netAmount     Int
  currency      String    @default("ARS")
  status        String    @default("pendiente") // pendiente | pagado | cancelado
  provider      String    @default("mercadopago-demo")
  checkoutToken String    @unique @default(cuid())
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  review Review?
}
