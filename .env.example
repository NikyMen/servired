# Copiá lo que necesites a .env.local y completá los valores.
#
# .env      -> valores por defecto, SIN secretos (está trackeado por git)
# .env.local -> tus secretos (lo ignora .gitignore, nunca se commitea)

DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# OAuth. Callbacks productivos:
# https://servired.consultoriadigital.io/api/auth/callback/google
# https://servired.consultoriadigital.io/api/auth/callback/facebook
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
OAUTH_STATE_SECRET="cambiá-este-secreto-largo"

# Correo (verificación, restablecer contraseña y avisos).
# Envío por Brevo: el plan gratis da 300 correos por día y permite firmar
# servired.ar para no caer en spam. SMTP_USER es el login que da Brevo
# (termina en @smtp-brevo.com), NO la casilla del From.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# El From es un no-reply: sale por Brevo y nadie lo lee. Las respuestas van a
# la casilla de Zoho, que sí lee una persona. Separarlas evita que los rebotes
# de cada tanda le bajen la reputación a la casilla de consultas.
EMAIL_FROM="ServiRed <no-reply@servired.ar>"
EMAIL_REPLY_TO="consultas@servired.ar"
# Clave del barrido de avisos por correo (mensajes sin contestar). Sin ella la
# ruta /api/cron/avisos queda apagada. La usa el crontab del servidor:
#   */15 * * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3655/api/cron/avisos
CRON_SECRET=""
EMAIL_VERIFICATION_SECRET="cambiá-este-secreto-largo"

# KYC: clave hexadecimal de 32 bytes y carpeta privada fuera de public/.
# Guarda DNI (hasta 8 MB) y video MP4/WEBM (hasta 25 MB).
KYC_ENCRYPTION_KEY=""
PRIVATE_UPLOAD_DIR=""

# Botón flotante "¿Necesitás ayuda?" (WhatsApp de soporte). 10 dígitos:
# característica sin 0 y número sin 15 (ej. 3794123456). Si está, manda sobre
# lo cargado en /admin. El mensaje es opcional.
SOPORTE_WHATSAPP=""
SOPORTE_WHATSAPP_MENSAJE="Hola, necesito ayuda con ServiRed."

# Acceso a /admin (no los publiques ni los subas al repositorio)
ADMIN_EMAIL="admin@servired.ar"
ADMIN_PASSWORD="cambiá-esta-clave"
ADMIN_SESSION_SECRET="cambiá-este-secreto-largo"

# ServiRed IA. Sacala en https://platform.deepseek.com/api_keys
# VA EN .env.local, no acá ni en .env: los dos van a git.
DEEPSEEK_API_KEY=""
