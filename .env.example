# Copiá lo que necesites a .env.local y completá los valores.
#
# .env      -> valores por defecto, SIN secretos (está trackeado por git)
# .env.local -> tus secretos (lo ignora .gitignore, nunca se commitea)

DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# OAuth. Callbacks productivos:
# https://servired.consultoriadigital.io/api/auth/callback/google
# https://servired.consultoriadigital.io/api/auth/callback/facebook
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
OAUTH_STATE_SECRET="cambiá-este-secreto-largo"

# Verificación por correo
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ServiRed <no-reply@servired.consultoriadigital.io>"
EMAIL_VERIFICATION_SECRET="cambiá-este-secreto-largo"

# KYC: clave hexadecimal de 32 bytes y carpeta privada fuera de public/.
# Guarda DNI (hasta 8 MB) y video MP4/WEBM (hasta 25 MB).
KYC_ENCRYPTION_KEY=""
PRIVATE_UPLOAD_DIR=""

# Acceso a /admin (no los publiques ni los subas al repositorio)
ADMIN_EMAIL="admin@servired.ar"
ADMIN_PASSWORD="cambiá-esta-clave"
ADMIN_SESSION_SECRET="cambiá-este-secreto-largo"

# ServiRed IA. Sacala en https://platform.deepseek.com/api_keys
# VA EN .env.local, no acá ni en .env: los dos van a git.
DEEPSEEK_API_KEY=""
